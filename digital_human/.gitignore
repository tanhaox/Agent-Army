# 环境变量（含 API key，禁止入库）
.env
.env.*

# 工作流历史备份（多版本迭代保留，仅本地）
workflows/*.bak_*

# 数字人 Web UI 配置文件（包含敏感信息，已加入 .gitignore）
config/app.yaml

# 数据库文件
data/pipeline.db
data/*.bak.*
data/pipeline.db.pre_voice_cleanup_*.bak

# 原始数据 / 临时调试
data/raw/
tmp/

# 输出产物
outputs/
projects/
references/

# 调试/测试残留
_*.txt
_*.json
news_dashboard*.html
news_data.json
tests/artifacts/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# IDE
.vscode/
.idea/

# 日志
logs/
*.log

# 系统
Thumbs.db
.DS_Store
