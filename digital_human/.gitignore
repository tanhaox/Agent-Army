# 环境变量（含 API key，禁止入库）
.env
.env.*

# 工作流历史备份（多版本迭代保留，仅本地）
workflows/*.bak_*

# 数字人 Web UI 配置文件（包含敏感信息，已加入 .gitignore）
config/app.yaml

# 数据库文件
data/pipeline.db
data/*.bak.*
data/pipeline.db.pre_voice_cleanup_*.bak

# 原始数据 / 临时调试
data/raw/
tmp/

# 输出产物
outputs/
projects/
references/

# 调试/测试残留
_*.txt
_*.json
news_dashboard*.html
news_data.json
tests/artifacts/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# IDE
.vscode/
.idea/

# 日志
logs/
*.log

# 系统
Thumbs.db
.DS_Store

# 剪映 J 线：参考仓库克隆（调查用，本地保留）
_ref_*/

# 剪映模板明文快照（847 文件，研究原料库，仅本地）
data/jy_template_snapshot/

# 剪映实验残留
data/jy_expA_bg.png
scripts/_tmp_*.py
data/jy_sounds/

# 剪映 BGM 音频文件本体（语义库在 config/jy_bgm_semantics.json 跟踪）
data/jy_bgm/

# 地缘提示词优化循环批次(成稿与豆包点评, 本地)
data/geo_batch/
