# 短剧AI - 智能制片工厂 环境变量配置
# 复制此文件为 .env 并修改为实际值: cp .env.example .env

# PostgreSQL（必填）
POSTGRES_USER=shortfilm
POSTGRES_PASSWORD=          # 必填！设置强密码
POSTGRES_DB=shortfilm

# 数据库连接（Docker 内部使用 postgres 服务名）
DATABASE_URL=postgresql+asyncpg://shortfilm:YOUR_PASSWORD@postgres:5432/shortfilm

# Redis
REDIS_URL=redis://redis:6379/0

# --- LLM 配置 ---
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 图片/视频 Provider ---
IMAGE_PROVIDER=comfyui
VIDEO_PROVIDER=seedance

# 火山引擎 Seedream 图像生成
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-260128

# 火山引擎 Seedance 视频生成
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128

# --- 安全配置 ---
CORS_ORIGINS=http://localhost,http://127.0.0.1
# ENCRYPTION_KEY=  # 留空则 API Key 不加密；生产环境建议设置
#   生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
