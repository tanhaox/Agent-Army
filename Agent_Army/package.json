{
  "name": "agent-army",
  "version": "1.0.0",
  "description": "多智能体协作AI系统 - Agent Army",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:benchmark": "ts-node tests/benchmark/run.ts",
    "test:stress": "ts-node tests/stress/run.ts",
    "test:report": "ts-node tests/generate-report.ts",
    "test:all": "npm run test:prepare && npm run test:benchmark && npm run test:ab && npm run test:stress && npm run test:report",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "multi-agent",
    "langgraph",
    "autogen",
    "crewai",
    "zhipu",
    "deepseek",
    "ai",
    "agent-collaboration"
  ],
  "author": "AI-Agent-Local",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "langgraph": "^0.2.0",
    "ioredis": "^5.3.2",
    "better-sqlite3": "^9.4.3",
    "winston": "^3.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "dotenv": "^16.4.1",
    "yaml": "^2.3.4",
    "axios": "^1.6.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/better-sqlite3": "^7.6.8",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
