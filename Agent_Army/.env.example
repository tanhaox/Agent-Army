# ===========================================
# Agent Army 环境变量配置模板
# ===========================================

# 智谱AI配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MAX_PLAN_QUOTA=1600  # 每5小时总量
ZHIPU_SEARCH_QUOTA_STD=4962
ZHIPU_SEARCH_QUOTA_PRO=2492
ZHIPU_SEARCH_QUOTA_QUARK=2500

# DeepSeek配置（基准测试用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BENCHMARK_MODE=true

# OpenAI配置（高质量场景）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=true
OPENAI_FALLBACK=true

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_army
REDIS_URL=redis://localhost:6379

# 马来西亚代理（海外API）
MALAYSIA_PROXY_URL=http://157.245.195.58:8080
MALAYSIA_TRAFFIC_LIMIT=2000000000000  # 2TB

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 服务配置
PORT=6001
NODE_ENV=development
