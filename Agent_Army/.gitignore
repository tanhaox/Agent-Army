# ===========================================
# Agent Army - Git Ignore 配置
# ===========================================

# 凭证和密钥（最重要）
credentials/api_keys/*.key
credentials/tokens/*.token
credentials/ssh/*/id_rsa
credentials/ssh/*/id_rsa.pub
credentials/licenses/*.lic
*.pem
*.key

# 环境变量
.env
.env.local
.env.*.local

# 临时文件
.temp/
*.tmp
*.swp
*.swo
*~

# 测试输出
tests/outputs/
coverage/
.nyc_output/

# 日志
data/logs/*.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 数据缓存（股票代码映射等）
data/*.json
data/*.csv
data/*.pkl
!data/.gitkeep

# 依赖
node_modules/
__pycache__/
*.pyc
.pyo
.pyd
pip-log.txt
pip-delete-this-directory.txt

# 编译输出
dist/
build/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 备份文件
*.bak
*.backup
*.old

# 压缩文件
*.zip
*.tar.gz
*.rar

# 临时数据库
*.db-journal
*.sqlite-journal

# Package locks
package-lock.json
yarn.lock
pnpm-lock.yaml

# 测试缓存
.jest-cache/
.ts-jest-cache/

# 文档生成
docs/_build/

# 临时报告和分析（开发过程中的临时文档）
docs/temp_reports/
*_REPORT.md
*_ANALYSIS.md
*_PLAN.md
!README.md
!COMPREHENSIVE_TEST_REPORT.md

# 归档（可选，如果想跟踪归档文件则注释掉）
# .archive/
