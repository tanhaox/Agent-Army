          "description": "2合1：新闻监控 + 情绪监控",
          "class": "InfoMonitoringAI",
          "module": "src.agents.business.monitoring.info_monitoring_ai"
        },
        {
          "id": "capital_monitoring_ai",
          "name": "资金监控AI",
          "description": "2合1：资金监控 + 龙虎榜",
          "class": "CapitalMonitoringAI",
          "module": "src.agents.business.monitoring.capital_monitoring_ai"
        }
