# ScriptForge 后端环境配置
# 复制此文件到 backend/.env 并填入实际值

# ── 数据库 ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://scriptforge:scriptforge123@postgres:5432/scriptforge
POSTGRES_PASSWORD=scriptforge123

# ── DeepSeek API（必填）──────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ─────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Celery ───────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Embedding ────────────────────────────────────────
EMBEDDING_PROVIDER=bge
VECTOR_STORE=pgvector

# ── 路径（容器内路径，通常无需修改）─────────────────────
WHISPER_MODEL_PATH=./models/whisper
SENSITIVE_WORDS_PATH=./data/sensitive_words.txt

# ── 安全 ─────────────────────────────────────────────
SECRET_KEY=generate-a-random-secret-key
DEBUG=false

# ── API 认证（留空=禁用）──────────────────────────────
API_AUTH_KEY=

# ── 端口映射（对应 docker-compose.yml）─────────────────
POSTGRES_PORT=5432
REDIS_PORT=6381
CHROMA_PORT=8001
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── 磁盘空间阈值 ──────────────────────────────────────
DISK_USAGE_WARNING_GB=50
DISK_USAGE_CRITICAL_GB=100
