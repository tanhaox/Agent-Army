# ScriptForge 后端环境配置
# 复制此文件为 .env 并填入实际值

# 数据库
DATABASE_URL=postgresql+asyncpg://scriptforge:CHANGE_ME@localhost:5432/scriptforge

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Embedding (bge / jieba)
EMBEDDING_PROVIDER=bge
VECTOR_STORE=pgvector

# 路径
WHISPER_MODEL_PATH=./models/whisper
SENSITIVE_WORDS_PATH=./data/sensitive_words.txt

# 安全
SECRET_KEY=generate-a-random-secret-key
DEBUG=true

# API 认证（留空=禁用，设置为随机字符串启用）
API_AUTH_KEY=

# 磁盘空间阈值（GB）
DISK_USAGE_WARNING_GB=50
DISK_USAGE_CRITICAL_GB=100
